# Copie este archivo a .env y complete los valores. .env NO se sube a ningún repositorio.
# Alternativa más segura: python -m app.main set-credential <NOMBRE> (Windows Credential Manager).
MYE_USER=
MYE_PASSWORD=
CADI_DOCUMENT=
CADI_PASSWORD=
# API de terceros (Silogtran) para completar proveedores en MyE
TERCEROS_API_KEY=
# TERCEROS_API_URL=https://apis-legalizacion-silogtran.onrender.com

# Opcionales
# MYE_DOCUMENT_TYPE=Documento Soporte - DE25 - 8759
CADI_REVIEWER=  # obligatorio: «<cédula> - <NOMBRE COMPLETO>» tal como aparece en CADI
# MYE_OBSERVATION_TEMPLATE={consolidado} {dd} {month} {yyyy}
# CADI_OBSERVATION_TEMPLATE={consolidado} {dd} {month} {yyyy}
# DIAN_MAX_WAIT_SECONDS=600
# DIAN_POLL_SECONDS=15
# TIMEOUT_MS=30000
